{
  "name": "@acpanel/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "hash-password": "tsx scripts/hash-password.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "archiver": "^7.0.1",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
